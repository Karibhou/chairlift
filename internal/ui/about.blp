using Gtk 4.0;
using Adw 1;

// The About dialog. internal/window sets application-name (the product name
// has one owner, internal/branding) and version before presenting it.
Adw.AboutDialog about_dialog {
  application-icon: "io.projectbluefin.chairlift";
  developer-name: "Project Bluefin";
  website: "https://github.com/projectbluefin/chairlift";
  issue-url: "https://github.com/projectbluefin/chairlift/issues";
  license-type: gpl_3_0;
  copyright: "© 2024-2026 Project Bluefin";
  developers: [
    "Brian Ketelsen",
    "ChairLift Contributors",
  ];
}
